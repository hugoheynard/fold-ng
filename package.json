{
  "name": "fold-ng",
  "version": "0.1.0",
  "description": "Accessible, dark-first Angular 22 UI component library & design system — signals-first, standalone, zoneless, SSR-ready. Design tokens + WCAG-minded components, themeable to the bone.",
  "keywords": [
    "angular",
    "angular-22",
    "angular-components",
    "ui-library",
    "ui-components",
    "component-library",
    "design-system",
    "design-tokens",
    "css-variables",
    "signals",
    "zoneless",
    "standalone",
    "ssr",
    "dark-theme",
    "theme",
    "theming",
    "accessible",
    "a11y",
    "wcag",
    "overlay",
    "dialog"
  ],
  "author": "Hugo Heynard",
  "license": "MIT",
  "homepage": "https://github.com/hugoheynard/fold#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugoheynard/fold.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/hugoheynard/fold/issues"
  },
  "type": "module",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "exports": {
    "./tokens.css": "./src/tokens/index.css",
    "./tokens/primitives.css": "./src/tokens/primitives.css",
    "./tokens/scales.css": "./src/tokens/scales.css",
    "./tokens/semantic.css": "./src/tokens/semantic.css",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort --host",
    "dev:watch": "concurrently -n tsc,lint,vite -c blue,magenta,green \"pnpm run dev:watch:tsc\" \"pnpm run dev:watch:lint\" \"pnpm run dev\"",
    "dev:watch:tsc": "tsc --noEmit --watch --preserveWatchOutput -p tsconfig.app.json",
    "dev:watch:lint": "onchange \"src/**/*.ts\" \"dev/**/*.ts\" --initial -- pnpm run lint",
    "dev:build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:api": "typedoc",
    "lint": "eslint src dev",
    "clean": "rm -rf dist out-tsc docs-api .angular *.tsbuildinfo"
  },
  "peerDependencies": {
    "@angular/common": "^22",
    "@angular/core": "^22",
    "@angular/forms": "^22",
    "@angular/platform-browser": "^22"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@analogjs/vitest-angular": "^2.6.2",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.3.5",
    "vitest": "^4.0.8",
    "zone.js": "~0.15.0"
  }
}
