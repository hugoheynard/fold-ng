{
  "name": "fold-ng",
  "version": "0.3.0",
  "description": "Accessible, dark-first Angular 22 UI component library & design system — signals-first, standalone, zoneless, SSR-ready. Design tokens + WCAG-minded components, themeable to the bone.",
  "keywords": [
    "angular",
    "angular-22",
    "angular-components",
    "ui-library",
    "ui-components",
    "component-library",
    "design-system",
    "design-tokens",
    "css-variables",
    "signals",
    "zoneless",
    "standalone",
    "ssr",
    "dark-theme",
    "theme",
    "theming",
    "accessible",
    "a11y",
    "wcag",
    "overlay",
    "dialog",
    "angular-ui",
    "signals-first"
  ],
  "author": "Hugo Heynard",
  "license": "MIT",
  "homepage": "https://hugoheynard.github.io/fold-ng/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugoheynard/fold-ng.git"
  },
  "bugs": {
    "url": "https://github.com/hugoheynard/fold-ng/issues"
  },
  "type": "module",
  "private": false,
  "packageManager": "pnpm@10.12.1",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "exports": {
    "./tokens.css": "./src/tokens/index.css",
    "./tokens/primitives.css": "./src/tokens/primitives.css",
    "./tokens/scales.css": "./src/tokens/scales.css",
    "./tokens/semantic.css": "./src/tokens/semantic.css",
    ".": {
      "types": "./src/public-api.ts",
      "import": "./src/public-api.ts"
    }
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite --port 5174 --strictPort --host",
    "dev:watch": "concurrently -n tsc,lint,vite -c blue,magenta,green \"pnpm run dev:watch:tsc\" \"pnpm run dev:watch:lint\" \"pnpm run dev\"",
    "dev:watch:tsc": "tsc --noEmit --watch --preserveWatchOutput -p tsconfig.app.json",
    "dev:watch:lint": "onchange \"src/**/*.ts\" \"demo/**/*.ts\" --initial -- pnpm run lint",
    "stats": "node scripts/gen-stats.mjs",
    "predev:build": "node scripts/gen-stats.mjs",
    "dev:build": "vite build",
    "build": "rm -rf dist && ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/finalize-dist.mjs",
    "verify:pack": "pnpm run build && publint dist && attw --pack dist --ignore-rules cjs-resolves-to-esm --exclude-entrypoints tokens.css tokens/primitives.css tokens/scales.css tokens/semantic.css",
    "pack:check": "pnpm run build && cd dist && npm pack --dry-run",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:beta": "node scripts/release.mjs beta",
    "deprecate": "node scripts/deprecate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:api": "typedoc",
    "lint": "eslint src demo",
    "lint:templates": "tsx scripts/check-templates.ts",
    "clean": "rm -rf dist out-tsc docs-api .angular *.tsbuildinfo"
  },
  "peerDependencies": {
    "@angular/common": "^22",
    "@angular/core": "^22",
    "@angular/forms": "^22",
    "@angular/platform-browser": "^22"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@arethetypeswrong/cli": "^0.18.5",
    "@analogjs/vitest-angular": "^2.6.2",
    "@angular/build": "^22.0.7",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.1.2",
    "ng-packagr": "^22.0.1",
    "onchange": "^7.1.0",
    "prettier": "^3.5.3",
    "publint": "^0.3.22",
    "rxjs": "^7.8.0",
    "tsx": "^4.19.3",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.3.5",
    "vitest": "^4.0.8",
    "zone.js": "~0.15.0"
  }
}
