{
  "name": "@sh3pherd/ui",
  "version": "0.0.0",
  "description": "SH3PHERD design system — design tokens and Angular UI components. Dark-first, light theme via [data-theme=\"light\"].",
  "author": "Hugo Heynard",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens.css": "./src/tokens/index.css",
    "./tokens/primitives.css": "./src/tokens/primitives.css",
    "./tokens/scales.css": "./src/tokens/scales.css",
    "./tokens/semantic.css": "./src/tokens/semantic.css",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "../../dev-toolbox/scripts/clean:package.sh"
  },
  "peerDependencies": {
    "@angular/common": "^22",
    "@angular/core": "^22",
    "@angular/platform-browser": "^22"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@analogjs/vitest-angular": "^2.6.2",
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/platform-browser": "^22.0.5",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.0.8",
    "zone.js": "~0.15.0"
  }
}
