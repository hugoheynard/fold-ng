{
  "name": "@sh3pherd/ui",
  "version": "0.0.0",
  "description": "SH3PHERD design system — design tokens and Angular UI components. Dark-first, light theme via [data-theme=\"light\"].",
  "author": "Hugo Heynard",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens.css": "./src/tokens/index.css",
    "./tokens/primitives.css": "./src/tokens/primitives.css",
    "./tokens/scales.css": "./src/tokens/scales.css",
    "./tokens/semantic.css": "./src/tokens/semantic.css",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort --host",
    "dev:watch": "concurrently -n tsc,lint,vite -c blue,magenta,green \"pnpm run dev:watch:tsc\" \"pnpm run dev:watch:lint\" \"pnpm run dev\"",
    "dev:watch:tsc": "tsc --noEmit --watch --preserveWatchOutput -p tsconfig.app.json",
    "dev:watch:lint": "onchange \"src/**/*.ts\" \"dev/**/*.ts\" --initial -- pnpm run lint",
    "dev:build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src dev",
    "clean": "../../dev-toolbox/scripts/clean:package.sh"
  },
  "peerDependencies": {
    "@angular/common": "^22",
    "@angular/core": "^22",
    "@angular/forms": "^22",
    "@angular/platform-browser": "^22"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@analogjs/vitest-angular": "^2.6.2",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.28.0",
    "@sh3pherd/eslint-config": "workspace:*",
    "eslint": "^9.28.0",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.3.5",
    "vitest": "^4.0.8",
    "zone.js": "~0.15.0"
  }
}
