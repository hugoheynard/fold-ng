{
  // Self-contained — NO `extends "../../…"`. Originally inlined from the
  // monorepo's tsconfig.base.flags.json + tsconfig.angular.json. Now extracted,
  // fold-ng leads: it hardens beyond the monorepo base (noUncheckedIndexedAccess,
  // exactOptionalPropertyTypes, strictStandalone, typeCheckHostBindings) — never
  // loosen one.
  "compilerOptions": {
    // --- Strictness (types) ---
    "strict": true,
    "strictPropertyInitialization": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    // arr[i] / obj[key] are typed `T | undefined` — the access must be guarded.
    "noUncheckedIndexedAccess": true,
    // `x?: T` (may be absent) is not the same as `x: T | undefined` (present, set
    // to undefined) — matters for a public API surface.
    "exactOptionalPropertyTypes": true,

    // --- Robustness / readability ---
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,
    "allowUnusedLabels": false,

    // --- Interop & modules ---
    "verbatimModuleSyntax": true,
    // Each file must transpile in isolation (matches esbuild/vite), and a
    // side-effect import that resolves to nothing is an error.
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    // --- Build ergonomics ---
    "skipLibCheck": true,
    "incremental": true,
    "sourceMap": true,
    "removeComments": false,
    "allowJs": false,

    // --- Decorators (Angular) ---
    "experimentalDecorators": true,

    // --- Target / module (from tsconfig.angular.json) ---
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    // --- Package build ---
    "types": ["node", "vitest/globals"],
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {}
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    // Every component/directive/pipe must be standalone — no NgModule slips in.
    "strictStandalone": true,
    // Type-check `host: {}` bindings the same way templates are checked.
    "typeCheckHostBindings": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
